# All resume / JD loading goes through fs_tools, sandboxed to this directory
WORKSPACE_ROOT=./data

# Embedding backend: huggingface (local, default) | gemini (API) | fake (tests only)
EMBEDDER=huggingface
# Sentence-transformers model id used when EMBEDDER=huggingface
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Gemini (only needed for EMBEDDER=gemini) ---
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required when EMBEDDER=gemini. Supported: gemini-embedding-001 (text-only, uses
# task types RETRIEVAL_DOCUMENT / RETRIEVAL_QUERY, 2,048 input tokens) or gemini-embedding-2
# (task instruction in the text, one request per input, 8,192 input tokens).
# Example: GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_MODEL=
# Output dimensions, 128-3072 (recommended 768, 1536 or 3072); blank = model default (3072)
GEMINI_EMBEDDING_DIM=

# Chroma persistent storage directory
CHROMA_DIR=./.chroma

# Reference date (YYYY-MM-DD) for "present" roles and years-of-experience maths; blank = today
AS_OF_DATE=

# Byte-compiled / cache
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env

# Tool caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Vector store
.chroma/

# Generated results (keep the folder). The sample outputs under results/samples/ and the
# evaluation reports under results/eval/ are committed for graders to read; every other
# results JSON stays local.
results/**/*.json
!results/samples/**/*.json
!results/eval/**/*.json

# Jupyter
.ipynb_checkpoints/

# Hugging Face model cache (if redirected into the project)
.cache/
hf_cache/
.hf_cache/

# Build / output folders
build/
dist/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
